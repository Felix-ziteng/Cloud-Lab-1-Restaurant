// 对应 docs/DATA_MODEL.md 中的实体设计。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 门店能力配置：单店部署下是单行"单例"（固定 id = 1），决定这份部署要不要暴露
// 厨房看板 / 外卖 / 预定这些可选模块。见 docs/ARCHITECTURE.md 关于产品化配置的决策。
model StoreConfig {
  id               Int     @id @default(1)
  kdsScreenEnabled Boolean @default(true)
  // 外卖/自提自助下单和预定这两个模块默认关闭：前者需要暴露到公网（见 ops/Caddyfile），
  // 后者也是"按客户定制"的可选模块，产品化阶段默认不为每个部署打开，只有客户明确需要时
  // 才单独为那家店的部署打开——见跟用户的决策记录（2026-08-20）
  deliveryEnabled    Boolean  @default(false)
  reservationEnabled Boolean  @default(false)
  // 界面视觉主题，店长在前台"门店设置"里切换，顾客端/厨房端/前台共用同一份配置
  uiTheme            String   @default("modern")
  // 桌台平板点餐视图的布局：菜单少的店用 compact（紧凑），菜单多/自助餐用 browse（长菜单）
  tabletMenuLayout       String   @default("compact")
  // 这两个开关默认关闭：不强迫所有店铺维护辣度/过敏原字段，开启后新增/编辑菜品才必须标注（见 menu.service.ts）
  showSpicyLevel         Boolean  @default(false)
  showAllergens          Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  @@map("store_config")
}

enum TableStatus {
  idle
  occupied
  pending_clear
}

enum TableSessionStatus {
  open
  pending_checkout
  closed
}

enum OrderType {
  dine_in
  takeout
  delivery
}

enum OrderStatus {
  open
  awaiting_payment
  paid
  cancelled
}

enum KitchenStatus {
  pending
  preparing
  done
}

enum ActorType {
  customer
  staff
}

enum StaffRole {
  staff
  manager
}

enum AccountStatus {
  active
  inactive
}

enum DeliveryStatus {
  unassigned
  assigned
  picked_up
  delivering
  delivered
}

enum PaymentMethod {
  cash
  staff_qr
  rider_cod
}

enum CollectedByType {
  staff
  rider
}

enum PriceAdjustmentType {
  discount
  comp
  void
  price_override
}

enum ReservationStatus {
  pending
  arrived
  cancelled
  no_show
}

enum PrintJobType {
  kitchen
  receipt
}

enum PrintJobStatus {
  pending
  printed
  failed
}

model Table {
  id          String      @id @default(uuid())
  tableNumber String      @unique
  capacity    Int
  zone        String?
  status      TableStatus @default(idle)
  // 每桌固定 4 位开台密码，明文存储（要贴在桌上给人看、店长要能在管理界面查看/打印，
  // 不是安全边界）。平板凭密码直接定位到这张桌，不管这张桌当前空闲还是已被占用——
  // 取代原来"全店统一密码 + 只能选空闲桌"的机制，见 tables.service.ts 的 resolveByPasscode
  passcode String @unique

  sessions     TableSessionTable[]
  reservations Reservation[]

  @@map("tables")
}

model TableSession {
  id              String              @id @default(uuid())
  partySize       Int
  status          TableSessionStatus  @default(open)
  openedByStaffId String?
  openedBy        StaffAccount?       @relation(fields: [openedByStaffId], references: [id])
  openedAt        DateTime            @default(now())
  closedAt        DateTime?
  reservationId   String?             @unique
  reservation     Reservation?        @relation(fields: [reservationId], references: [id])

  tables TableSessionTable[]
  order  Order?

  @@map("table_sessions")
}

// 支持并台：一个会话可以关联多张桌台（见 DATA_MODEL.md 3.2）
model TableSessionTable {
  sessionId String
  tableId   String
  session   TableSession @relation(fields: [sessionId], references: [id])
  table     Table        @relation(fields: [tableId], references: [id])

  @@id([sessionId, tableId])
  @@map("table_session_tables")
}

model Order {
  id                String        @id @default(uuid())
  // 顾客自助下单外卖/自提没有账号体系，靠"订单号 + 手机号"找回订单状态（见 OrdersService.lookupGuestOrder），
  // UUID 主键不适合让顾客手打，所以另开一个人类可读的顺序号
  orderNumber       Int           @unique @default(autoincrement())
  type              OrderType
  tableSessionId    String?       @unique
  tableSession      TableSession? @relation(fields: [tableSessionId], references: [id])
  status            OrderStatus   @default(open)
  subtotal          Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @default(0) @db.Decimal(10, 2)
  createdByType     ActorType
  createdByStaffId  String?
  createdByStaff    StaffAccount? @relation(fields: [createdByStaffId], references: [id])
  customerContact   String?
  pickupTime        DateTime?
  createdAt         DateTime      @default(now())

  items            OrderItem[]
  payments         Payment[]
  priceAdjustments PriceAdjustment[]
  deliveryInfo     DeliveryInfo?
  printJobs        PrintJob[]

  @@map("orders")
}

// 打印队列：ARCHITECTURE.md 2.7 "打印代理" 的落地——payload 是下单/收款那一刻的快照
// （菜名、数量、金额等都存成 JSON），打印代理不需要反查订单当前状态，即使订单后续被改价/
// 作废也不影响这张已经生成的小票内容。status 支持失败重试：打印代理本地服务离线/重启时，
// 靠 GET /print-jobs/pending 补打漏掉的任务，不完全依赖 WebSocket 这种"发了就忘"的通知。
model PrintJob {
  id           String         @id @default(uuid())
  type         PrintJobType
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  payload      Json
  status       PrintJobStatus @default(pending)
  errorMessage String?
  createdAt    DateTime       @default(now())
  printedAt    DateTime?

  @@map("print_jobs")
}

model OrderItem {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  dishId            String
  dish              Dish          @relation(fields: [dishId], references: [id])
  dishNameSnapshot  String
  unitPriceSnapshot Decimal       @db.Decimal(10, 2)
  quantity          Int
  notes             String?
  // 下单时选的加料/口味选项快照（文字，不存 optionId 外键）：
  // { groupName, optionLabel, priceDelta }[]，商家以后改/删选项组模板不影响历史订单显示
  selectedModifiers Json?
  kitchenStatus     KitchenStatus @default(pending)
  // 0 = 尚未提交的购物车项；submit 时统一分配真实轮次并写入 submittedAt（见 orders.service.ts）
  roundNumber       Int           @default(0)
  submittedAt       DateTime?
  isVoided          Boolean       @default(false)
  addedByType       ActorType
  addedByStaffId    String?
  addedByStaff      StaffAccount? @relation(fields: [addedByStaffId], references: [id])
  createdAt         DateTime      @default(now())

  priceAdjustments PriceAdjustment[]

  @@map("order_items")
}

model Category {
  id        String @id @default(uuid())
  name      String
  sortOrder Int    @default(0)

  dishes Dish[]

  @@map("categories")
}

model Dish {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  // null = 未标注；0/1/2/3 = 不辣/微辣/中辣/特辣（0 也是"已标注"，不是空）
  spicyLevel  Int?
  // 固定过敏原 id 清单（见 shared-types ALLERGEN_OPTIONS），空数组=已标注为"不含"或尚未编辑过
  allergens   String[] @default([])

  orderItems OrderItem[]
  modifierGroups DishModifierGroup[]

  @@map("dishes")
}

enum ModifierSelectionType {
  single_required // 必选单选，比如"选面型"
  single_optional // 可选单选，比如"辣度"
  multiple        // 可选多选，比如"加料"
}

// 门店级"选项组模板"：商家自己定义（不预设枚举），可以挂到多道菜上复用
model ModifierGroup {
  id            String                @id @default(uuid())
  name          String
  selectionType ModifierSelectionType
  sortOrder     Int                   @default(0)

  options   ModifierOption[]
  dishLinks DishModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id         String        @id @default(uuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal       @default(0) @db.Decimal(10, 2)
  sortOrder  Int           @default(0)

  @@map("modifier_options")
}

// 菜品 <-> 选项组模板 的多对多挂载：哪些菜适用哪些模板
model DishModifierGroup {
  dishId    String
  dish      Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  groupId   String
  // 组本身有没有被挂到菜品，由 ModifierGroupsService.delete() 主动查数量拦截（提示先取消勾选），
  // 这里故意不设 onDelete: Cascade——不能让删组的时候悄悄把挂载关系一起冲掉
  group     ModifierGroup @relation(fields: [groupId], references: [id])
  sortOrder Int           @default(0)

  @@id([dishId, groupId])
  @@map("dish_modifier_groups")
}

model StaffAccount {
  id      String        @id @default(uuid())
  name    String
  pinHash String // bcrypt 哈希，不存明文 PIN
  role    StaffRole     @default(staff)
  status  AccountStatus @default(active)

  openedSessions      TableSession[]
  createdOrders       Order[]
  addedOrderItems     OrderItem[]
  approvedAdjustments PriceAdjustment[]
  collectedPayments   Payment[]         @relation("StaffPayments")
  createdReservations Reservation[]

  @@map("staff_accounts")
}

model Rider {
  id      String        @id @default(uuid())
  name    String
  pinHash String
  status  AccountStatus @default(active)

  deliveries        DeliveryInfo[]
  collectedPayments Payment[]      @relation("RiderPayments")

  @@map("riders")
}

model DeliveryInfo {
  orderId          String    @id
  order            Order     @relation(fields: [orderId], references: [id])
  address          String
  contactPhone     String
  riderId          String?
  rider            Rider?    @relation(fields: [riderId], references: [id])
  status           DeliveryStatus @default(unassigned)
  codAmount        Decimal   @db.Decimal(10, 2)
  paymentConfirmed Boolean   @default(false)
  confirmedAt      DateTime?

  @@map("delivery_infos")
}

model Payment {
  id                  String          @id @default(uuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id])
  method              PaymentMethod
  amount              Decimal         @db.Decimal(10, 2)
  collectedByType     CollectedByType
  collectedByStaffId  String?
  collectedByStaff    StaffAccount?   @relation("StaffPayments", fields: [collectedByStaffId], references: [id])
  collectedByRiderId  String?
  collectedByRider    Rider?          @relation("RiderPayments", fields: [collectedByRiderId], references: [id])
  collectedAt         DateTime        @default(now())

  @@map("payments")
}

// 敏感操作审计记录：approvedBy 必须是 role = manager 的账号（业务规则在应用层校验）
model PriceAdjustment {
  id                String              @id @default(uuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id])
  orderItemId       String?
  orderItem         OrderItem?          @relation(fields: [orderItemId], references: [id])
  type              PriceAdjustmentType
  amount            Decimal             @db.Decimal(10, 2)
  reason            String?
  approvedByStaffId String
  approvedBy        StaffAccount        @relation(fields: [approvedByStaffId], references: [id])
  createdAt         DateTime            @default(now())

  @@map("price_adjustments")
}

model Reservation {
  id                String             @id @default(uuid())
  customerName      String
  phone             String
  partySize         Int
  reservedTime      DateTime
  tableId           String?
  table             Table?             @relation(fields: [tableId], references: [id])
  status            ReservationStatus  @default(pending)
  note              String?
  createdByStaffId  String
  createdBy         StaffAccount       @relation(fields: [createdByStaffId], references: [id])
  createdAt         DateTime           @default(now())
  arrivedAt         DateTime?

  session TableSession?

  @@map("reservations")
}
